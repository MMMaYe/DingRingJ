<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dingring</groupId>
        <artifactId>dingring</artifactId>
        <version>0.1.0</version>
    </parent>
    <artifactId>dingRing-adapter</artifactId>
    <packaging>jar</packaging>
    <name>dingRing-adapter</name>
    <description>接入层：REST API、WebSocket 消息收发、DTO 转换</description>

    <dependencies>
        <dependency>
            <groupId>com.dingring</groupId>
            <artifactId>dingRing-app</artifactId>
        </dependency>
        <!-- infrastructure：WsSessionRegistry 端口（WS 会话管理，Phase B 拆分） -->
        <dependency>
            <groupId>com.dingring</groupId>
            <artifactId>dingRing-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- P3 F4：MCP Server（Streamable HTTP /mcp），外部 Agent 清洗提交通道 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <!-- 测试：JUnit 5 + AssertJ + Mockito + MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
