<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dingring</groupId>
        <artifactId>dingring</artifactId>
        <version>0.1.0</version>
    </parent>
    <artifactId>dingRing-infrastructure</artifactId>
    <packaging>jar</packaging>
    <name>dingRing-infrastructure</name>
    <description>基础设施层：MyBatis 持久化、LLM 适配、记忆检索、事件发布</description>

    <dependencies>
        <dependency>
            <groupId>com.dingring</groupId>
            <artifactId>dingRing-domain</artifactId>
        </dependency>
        <!-- MyBatis -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <!-- Spring AI OpenAI（DeepSeek / Kimi / GLM 均兼容 OpenAI 接口） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <!-- SAA Nacos Prompt（Phase A：提示词热更新基础设施，Phase C 正式迁移 prompt） -->
        <!-- SAA BOM 1.1.2.3 未管理此 artifact，需显式指定版本 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-nacos-prompt</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>
        <!-- SAA Graph Core（Phase A 只引入依赖，Phase C 才用 StateGraph） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
        </dependency>
        <!-- SAA Agent Framework（Phase D：ReactAgent + Hook + Interceptor，提供 ReAct 循环 + 工具调用能力） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
        </dependency>
        <!-- Spring AOP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- Fastjson（JSON 序列化） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>
        <!-- Spring 上下文（事件发布） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- Spring WebSocket（WsSessionRegistryImpl / WsBroadcastAdapter 依赖 WebSocketSession） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-websocket</artifactId>
        </dependency>
        <!-- 测试：JUnit 5 + AssertJ + Mockito -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
